generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id          Int      @id @default(autoincrement())
  phone       String
  address     String
  province    String
  city        String
  postalCode  String
  description String?
  items       Json
  totalPrice  Int
  createdAt   DateTime @default(now())
  status      String   @default("در حال بررسی")
  plate       String   @default("")
  floor       String?
  unit        String?
  trackingCode String?
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
}

model User {
  id              Int       @id @default(autoincrement())
  phone           String    @unique
  password        String
  name            String?
  resetCode       String?
  resetCodeExpiry DateTime?
  orders          Order[]
}
