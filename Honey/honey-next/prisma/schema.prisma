generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id           Int      @id @default(autoincrement())
  phone        String
  address      String
  province     String
  city         String
  postalCode   String
  description  String?
  items        Json
  totalPrice   Int
  createdAt    DateTime @default(now())
  status       String   @default("در حال بررسی")
  plate        String   @default("")
  floor        String?
  unit         String?
  trackingCode String?
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
}

model User {
  id              Int       @id @default(autoincrement())
  phone           String    @unique
  password        String
  name            String?
  resetCode       String?
  resetCodeExpiry DateTime?
  orders          Order[]
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  message   String
  createdAt DateTime @default(now())
  seen      Boolean  @default(false)
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  price       Int
  shortDesc   String?
  description String?
  weight      String?
  honeyType   String?
  productYear String?
  expiry      String?
  benefits    String?
  suitableFor String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  images      ProductImage[]
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  filename  String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
}
